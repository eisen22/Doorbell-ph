rules_version = '2';

// =====================================================================
// firestore.rules — WHO MAY READ AND WRITE WHAT
// ---------------------------------------------------------------------
// Paste this into Firebase console -> Firestore Database -> Rules -> Publish.
// - Only signed-in staff (people with a users/{uid} profile) can read school data.
// - Parents (parents/{uid}) read only their own children's months and their own excuse requests.
// - The admin manages the school; a teacher writes attendance only for their own classes.
// - Messages: only the people in a conversation read it (and the admin); see MESSAGES below.
// - The audit log can be added to but never edited or deleted.
// If the app shows "Missing or insufficient permissions", one of these rules said no.
// =====================================================================
service cloud.firestore {
  match /databases/{database}/documents {

    // ----- helper checks -----
    function signedIn() { return request.auth != null; }
    // The signed-in person's profile: { name, email, role, teacherId }
    function account() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function isStaff() { return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)); }
    function isAdmin() { return isStaff() && account().role == 'admin'; }
    // A substitute teacher covering a class on one date (the admin's "Teacher absent" window saves
    // sections/{id}.schedule.teacherAway[date] = { kind: 'substitute', teacherId }).
    function coversSection(sectionId, date) {
      let away = get(/databases/$(database)/documents/sections/$(sectionId)).data.schedule.get('teacherAway', {});
      return isStaff() && account().role == 'teacher' && date is string && date in away
        && away[date].get('teacherId', '') == account().teacherId;
    }
    // The phone at the school gate (Doorbell Gate app) signs in with an account whose role is 'gate'.
    function isGate() { return isStaff() && account().role == 'gate'; }
    // True when the signed-in teacher is the teacher of that section.
    function teachesSection(sectionId) {
      return isStaff() && account().role == 'teacher'
        && get(/databases/$(database)/documents/sections/$(sectionId)).data.teacherId == account().teacherId;
    }

    // A subject teacher of that section (Grades 4 to 6: the admin lists them in sections/{id}.subjectTeacherIds).
    // They may mark attendance for the class (a child who arrives in their period) and confirm it.
    function subjectTeacher(sectionId) {
      return isStaff() && account().role == 'teacher'
        && account().teacherId in get(/databases/$(database)/documents/sections/$(sectionId)).data.get('subjectTeacherIds', []);
    }

    // ----- parent portal (src/parent/) -----
    // A parent signs in with an account whose email is p<09XXXXXXXXX>@parents.doorbell-ph-f12d0.firebaseapp.com
    // and has a parents/{uid} profile. parentKeys/{09XXXXXXXXX} lists that number's children.
    function parentEmailFor(mobile) { return 'p' + mobile + '@parents.doorbell-ph-f12d0.firebaseapp.com'; }
    function parentProfile() { return get(/databases/$(database)/documents/parents/$(request.auth.uid)).data; }
    // A parent who signs in with Google stays a parent only while the school keeps that Gmail on the
    // child's guardian record (parentEmails/{gmail} -> the same number).
    function isParent() {
      return signedIn() && exists(/databases/$(database)/documents/parents/$(request.auth.uid))
        && (parentProfile().get('via', '') != 'google' || googleParentOk(parentProfile().mobile));
    }
    function googleParentOk(mobile) {
      return request.auth.token.email_verified == true
        && exists(/databases/$(database)/documents/parentEmails/$(request.auth.token.email))
        && get(/databases/$(database)/documents/parentEmails/$(request.auth.token.email)).data.mobile == mobile;
    }
    function parentKey() { return get(/databases/$(database)/documents/parentKeys/$(parentProfile().mobile)).data; }
    function parentOf(studentId) { return isParent() && studentId in parentKey().studentIds; }

    // First-time setup flag. Anyone can read it (the sign-in page checks if setup is needed).
    // It can be created only once, together with the first admin profile.
    match /meta/setup {
      allow read: if true;
      allow create: if signedIn() && !exists(/databases/$(database)/documents/meta/setup);
    }

    // Staff profiles. A teacher can read only their own; the admin reads and writes all.
    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow write: if isAdmin();
      // The very first admin creates their own profile in the same batch that creates meta/setup.
      allow create: if signedIn() && request.auth.uid == uid && request.resource.data.role == 'admin'
        && !exists(/databases/$(database)/documents/meta/setup)
        && existsAfter(/databases/$(database)/documents/meta/setup);
    }

    // School settings, school year and calendar (meta/school, meta/calendar).
    match /meta/{id} {
      // meta/public = the school's name and office email, shown on the sign-in page (no sign-in yet).
      allow read: if isStaff() || id == 'public';
      allow write: if isAdmin();
    }

    // "Send me a new password" requests (worker/src/passwords.js makes the password and sends it).
    // The sign-in page now asks the Worker directly (worker/src/account.js); this is the backup when the
    // Worker cannot be reached: anyone may ask, the same number or email at most once every 5 minutes. The
    // admin may ask any time (new parent, new teacher or admin, "Send new password"). Nobody can read them:
    // the Worker uses the service account. One document per account: p_<09 number or Gmail> or s_<email>.
    function passwordRequestOk(id) {
      let d = request.resource.data;
      return d.keys().hasOnly(['who', 'login', 'reason', 'at', 'state']) && d.state == 'new' && d.login is string
        && ((d.who == 'parent' && (d.login.matches('09[0-9]{9}') || (d.reason == 'forgot' && d.login.size() <= 100 && d.login.matches('[^@ /A-Z]+@[^@ /A-Z]+')))
            && id == 'p_' + d.login)
          || (d.who == 'staff' && d.login.size() <= 100 && d.login.matches('[^@ /]+@[^@ /]+') && id == 's_' + d.login));
    }
    function forgotRequest() {
      return request.resource.data.reason == 'forgot' && request.resource.data.at == request.time;
    }
    match /passwordRequests/{id} {
      allow create: if passwordRequestOk(id) && (forgotRequest() || (isAdmin() && request.resource.data.reason in ['new', 'admin']));
      allow update: if passwordRequestOk(id) && (
        (forgotRequest() && (!(resource.data.at is timestamp) || request.time > resource.data.at + duration.value(5, 'm')))
        || (isAdmin() && request.resource.data.reason in ['new', 'admin']));
    }

    // Changes the admin asks the Worker to make (worker/src/account.js): a parent's new mobile number
    // ('mobile'), a teacher's new sign-in email ('staffEmail'), and the notice after a parent's Gmail changed
    // ('gmailNotice'). Only the admin; the Worker writes the result.
    match /accountChanges/{id} {
      allow read: if isAdmin();
      allow create: if isAdmin() && request.resource.data.state == 'new'
        && request.resource.data.kind in ['mobile', 'staffEmail', 'gmailNotice'];
    }
    // limits/{hash} (wait times) and emailChanges/{hash} (Gmail confirm links): no rule, so only the Worker
    // (service account) can use them.

    // School setup: only the admin changes these; all staff can read them.
    match /sections/{id}    { allow read: if isStaff(); allow write: if isAdmin(); }
    match /teachers/{id}    {
      allow read: if isStaff();
      allow write: if isAdmin();
      // A teacher turns their own email alerts for new messages on or off (Settings), and nothing else.
      allow update: if isStaff() && account().get('teacherId', '') == id
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['emailAlerts'])
        && request.resource.data.emailAlerts is bool;
    }
    match /students/{id}    { allow read: if isStaff(); allow write: if isAdmin(); }
    match /guardians/{id}   { allow read: if isStaff(); allow write: if isAdmin(); }
    match /enrollments/{id} { allow read: if isStaff(); allow write: if isAdmin(); }

    // One document per section per day.
    // The gate phone may add scans to any section (children of every class pass the same gate).
    match /attendance/{id} {
      allow read: if isStaff();
      allow create, update: if isAdmin() || isGate() || teachesSection(request.resource.data.sectionId)
        || subjectTeacher(request.resource.data.sectionId)
        || coversSection(request.resource.data.sectionId, request.resource.data.date);
      allow delete: if isAdmin();
    }
    // Announcements to parents (shown in the parent portal, optionally texted). The admin: the whole
    // school, some grade levels or one class; a teacher: one class they teach per document.
    match /announcements/{id} {
      allow read: if isStaff();
      allow create: if isAdmin()
        || (request.resource.data.get('sectionId', '') is string && request.resource.data.get('sectionId', '') != ''
            && (teachesSection(request.resource.data.sectionId) || subjectTeacher(request.resource.data.sectionId)));
      allow update, delete: if isAdmin();
    }
    // Seating chart of a class (one document per section, id = section id). Every teacher can see it;
    // the adviser, the class's subject teachers and the admin can change it.
    match /seating/{sectionId} {
      allow read: if isStaff();
      allow write: if isAdmin() || teachesSection(sectionId) || subjectTeacher(sectionId);
    }
    // A confirmed (locked) day. Only the admin can undo it.
    match /confirmations/{id} {
      allow read: if isStaff();
      allow create: if isAdmin() || teachesSection(request.resource.data.sectionId)
        || subjectTeacher(request.resource.data.sectionId)
        || coversSection(request.resource.data.sectionId, request.resource.data.date)
        || isGate(); // the Cloudflare Worker (worker/) closes classes nobody confirmed, with a gate account
      allow update, delete: if isAdmin();
    }

    // Outgoing texts (simulated) and in-app alerts.
    // A text always belongs to a child (studentId); only the admin may make the Settings test text.
    // The Worker also checks that the number is that child's guardian's before sending (worker/src/index.js).
    match /sms/{id} {
      allow read: if isStaff();
      allow create, update: if isAdmin() || (isStaff() && request.resource.data.get('studentId', '') != '');
      allow delete: if isAdmin();
    }
    match /notifications/{id} {
      allow read: if isStaff();
      allow create, update: if isStaff();
      allow delete: if isAdmin();
    }

    // ----- PARENT PORTAL -----
    // Which children belong to a mobile number, and the hash of the default password. Written by the admin
    // (engine.syncParentKey); a parent can read only the key of their own number.
    match /parentKeys/{mobile} {
      allow read: if isStaff() || (isParent() && parentProfile().mobile == mobile);
      allow write: if isAdmin();
    }
    // A parent's profile. Created on the first sign-in ONLY when the password typed (proof) matches the
    // default password's hash for that number, so a stranger cannot take over a parent's number.
    // Afterwards the parent may only remove the proof and clear the "default password" warning.
    match /parents/{uid} {
      allow read: if (signedIn() && request.auth.uid == uid) || isStaff();
      // Signing in with Google: the Gmail the school saved on the guardian record links it to that number.
      allow create: if signedIn() && request.auth.uid == uid && !isStaff()
        && request.resource.data.keys().hasOnly(['mobile', 'via', 'email', 'defaultPassword', 'createdAt'])
        && request.resource.data.via == 'google' && request.resource.data.defaultPassword == false
        && request.resource.data.email == request.auth.token.email
        && googleParentOk(request.resource.data.mobile);
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['mobile', 'proof', 'defaultPassword', 'createdAt'])
        && request.resource.data.mobile is string && request.resource.data.mobile.matches('09[0-9]{9}')
        && request.auth.token.email == parentEmailFor(request.resource.data.mobile)
        && request.resource.data.defaultPassword == true
        && exists(/databases/$(database)/documents/parentKeys/$(request.resource.data.mobile))
        && get(/databases/$(database)/documents/parentKeys/$(request.resource.data.mobile)).data.codeHash
           == hashing.sha256(request.resource.data.proof).toHexString().lower();
      allow update: if signedIn() && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['proof', 'defaultPassword', 'dismissed'])
        && !('proof' in request.resource.data);
      // The school moved this Gmail to another number: the Google parent follows it.
      allow update: if signedIn() && request.auth.uid == uid && resource.data.get('via', '') == 'google'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['mobile'])
        && googleParentOk(request.resource.data.mobile);
      allow delete: if isAdmin();
    }
    // Gmail -> parent number, for parents who sign in with Google (Admin -> Students -> guardian Gmail).
    // Readable only by that Google account; written by the admin.
    match /parentEmails/{email} {
      allow read: if signedIn() && request.auth.token.email == email;
      allow write: if isAdmin();
    }
    // One child's month as the parent sees it (confirmed days only). Written by staff and the Worker.
    match /parentDays/{id} {
      allow read: if isStaff() || parentOf(resource.data.studentId);
      allow write: if isStaff();
    }
    // Excuse requests: the parent asks, the class teacher (or admin) approves or declines.
    match /excuses/{id} {
      allow read: if isStaff() || (isParent() && resource.data.parentUid == request.auth.uid);
      allow create: if isParent()
        && request.resource.data.parentUid == request.auth.uid
        && parentOf(request.resource.data.studentId)
        && request.resource.data.status == 'pending'
        && request.resource.data.dates is list && request.resource.data.dates.size() > 0 && request.resource.data.dates.size() <= 10
        && request.resource.data.reason is string && request.resource.data.reason.size() <= 60
        && request.resource.data.get('note', '').size() <= 500
        && (!('periods' in request.resource.data) || (request.resource.data.periods is list && request.resource.data.periods.size() <= 12))
        && request.resource.data.get('files', []) is list && request.resource.data.get('files', []).size() <= 3
        && request.resource.data.keys().hasOnly(['id', 'studentId', 'sectionId', 'parentUid', 'studentName', 'guardianName', 'dates', 'reason', 'note', 'periods', 'files', 'status', 'createdAt']);
      allow update: if isAdmin() || teachesSection(resource.data.sectionId);
      allow delete: if isAdmin();
    }

    // ----- MESSAGES (src/messaging.js) -----
    // Conversations between parents, teachers and the school office; one can hold all three (3-way).
    // Each person is a key: 'office' (any admin), 't:<teacherId>', 'p:<09XXXXXXXXX>' (a parent's number).
    // Only the people in a conversation (members) read it. The admin can also read the others, for
    // oversight and "Remove all school data" (like Canvas admins, who can open any inbox by acting as the user,
    // and ParentSquare, where administrators see all transcripts). The website only opens one the office is not
    // in through Messages -> Review conversations, which asks for a reason and writes it to the audit log first.
    function myKey() {
      return isStaff() ? (account().role == 'admin' ? 'office' : 't:' + account().get('teacherId', ''))
        : (isParent() ? 'p:' + parentProfile().mobile : '');
    }
    function isMember(members) { return signedIn() && members is list && myKey() in members; }
    // For READING conversations and messages. The portal and the staff pages load them with a search
    // ("members contains me"); Firestore allows a search only if it can prove the rule from the search itself,
    // so this check must be just "my key is in members" (no other test on the document, e.g. `is list`).
    function canRead(members) { return signedIn() && myKey() in members; }
    // A teacher of that class: the adviser or one of its subject teachers.
    function teacherOfSection(sectionId, teacherId) {
      let sec = get(/databases/$(database)/documents/sections/$(sectionId)).data;
      return sec.get('teacherId', '') == teacherId || teacherId in sec.get('subjectTeacherIds', []);
    }
    match /threads/{id} {
      allow read: if isAdmin() || canRead(resource.data.members);
      // Staff start a conversation they are in. With a parent in it, a teacher must teach that child's class
      // (the class must be one of that parent's children's).
      allow create: if isStaff() && isMember(request.resource.data.members)
          && request.resource.data.createdBy == myKey()
          && request.resource.data.members.size() <= 12
          && (request.resource.data.get('parent', '') == '' || isAdmin()
              || ((teachesSection(request.resource.data.sectionId) || subjectTeacher(request.resource.data.sectionId))
                  && request.resource.data.sectionId in get(/databases/$(database)/documents/parentKeys/$(request.resource.data.parent)).data.get('sectionIds', [])))
        // A parent starts one about their own child with ONE teacher of that child's class, the office, or both.
        || (isParent()
          && request.resource.data.keys().hasOnly(['id', 'members', 'parent', 'parentName', 'studentId', 'studentName', 'sectionId', 'teacherId', 'office', 'names', 'createdBy', 'createdAt', 'lastAt', 'lastText', 'lastFrom', 'lastName', 'readAt'])
          && request.resource.data.parent == parentProfile().mobile
          && request.resource.data.createdBy == myKey()
          && parentOf(request.resource.data.studentId)
          && request.resource.data.sectionId in parentKey().get('sectionIds', [])
          && request.resource.data.office is bool && request.resource.data.teacherId is string
          && (request.resource.data.teacherId == '' ? request.resource.data.office
              : teacherOfSection(request.resource.data.sectionId, request.resource.data.teacherId))
          && request.resource.data.members == [myKey()]
               .concat(request.resource.data.teacherId == '' ? [] : ['t:' + request.resource.data.teacherId])
               .concat(request.resource.data.office ? ['office'] : []));
      // Staff in the conversation: send, mark read, add people (never remove anyone, never change the parent or child).
      // The parent: only the newest-message fields and their own "read" time.
      allow update: if isMember(resource.data.members) && (
          (isStaff() && request.resource.data.members.hasAll(resource.data.members)
            && request.resource.data.get('parent', '') == resource.data.get('parent', '')
            && request.resource.data.get('studentId', '') == resource.data.get('studentId', ''))
          || (isParent()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastAt', 'lastText', 'lastFrom', 'lastName', 'readAt'])
            && request.resource.data.get('readAt', {}).diff(resource.data.get('readAt', {})).affectedKeys().hasOnly([myKey()])
            && request.resource.data.lastFrom in [resource.data.lastFrom, myKey()]));
      allow delete: if isAdmin();
    }
    // A photo or PDF sent in a message (base64, at most about 700 KB: one Firestore document; Firebase Storage
    // would need the paid Blaze plan). Read one at a time by the people in its conversation (and the admin).
    // Never changed afterwards; only the admin can delete it ("Remove all school data").
    // A file attached to an excuse request: the parent who sent the request, or a teacher of that child's class
    // (the adviser or a subject teacher). The admin is allowed separately.
    function canOpenExcuseFile(excuseId) {
      let ex = get(/databases/$(database)/documents/excuses/$(excuseId)).data;
      return (signedIn() && ex.parentUid == request.auth.uid) || teachesSection(ex.sectionId) || subjectTeacher(ex.sectionId);
    }
    match /attachments/{id} {
      // Of a message: the people in its conversation. Of an excuse request: the admin, the class's adviser and
      // subject teachers, and the parent who sent it (canOpenExcuseFile). No other teacher or parent.
      allow get: if isAdmin()
        || (resource.data.get('threadId', '') != ''
            && isMember(get(/databases/$(database)/documents/threads/$(resource.data.threadId)).data.members))
        || (resource.data.get('excuseId', '') != '' && canOpenExcuseFile(resource.data.excuseId));
      allow list: if isAdmin();
      allow create: if signedIn()
        && request.resource.data.from == myKey()
        && request.resource.data.type in ['image/jpeg', 'image/png', 'image/webp', 'application/pdf']
        && request.resource.data.data is string && request.resource.data.data.size() <= 960000
        && request.resource.data.name is string && request.resource.data.name.size() <= 120
        && (
          // a message's file: by someone in that conversation (also a conversation created in the same save)
          (request.resource.data.keys().hasOnly(['id', 'threadId', 'from', 'name', 'type', 'size', 'data', 'at'])
            && request.resource.data.threadId is string
            && isMember(getAfter(/databases/$(database)/documents/threads/$(request.resource.data.threadId)).data.members))
          // an excuse request's file: by the parent who sends that request (in the same save)
          || (isParent()
            && request.resource.data.keys().hasOnly(['id', 'excuseId', 'from', 'name', 'type', 'size', 'data', 'at'])
            && request.resource.data.excuseId is string
            && getAfter(/databases/$(database)/documents/excuses/$(request.resource.data.excuseId)).data.parentUid == request.auth.uid)
        );
      allow update: if false;
      allow delete: if isAdmin();
    }
    // Email alerts waiting to be sent (src/messaging.js mailQueueDocs): one per teacher / the office per conversation.
    // Written by whoever sends a message (for the OTHER staff in that conversation); read and deleted by the
    // Worker (a gate account), which emails "X sent you a message" (no message text). The person it is for
    // deletes it by opening the conversation (the id ends with their key).
    match /mailQueue/{id} {
      allow read: if isGate() || isAdmin();
      allow create, update: if signedIn()
        && request.resource.data.keys().hasOnly(['id', 'threadId', 'to', 'at', 'fromName', 'studentName'])
        && request.resource.data.threadId is string && request.resource.data.to is string
        && id == request.resource.data.threadId + '_' + request.resource.data.to
        && request.resource.data.to != myKey()
        && (request.resource.data.to == 'office' || request.resource.data.to.matches('t:.+'))
        && isMember(getAfter(/databases/$(database)/documents/threads/$(request.resource.data.threadId)).data.members)
        && request.resource.data.to in getAfter(/databases/$(database)/documents/threads/$(request.resource.data.threadId)).data.members
        && request.resource.data.fromName is string && request.resource.data.fromName.size() <= 80
        && request.resource.data.studentName is string && request.resource.data.studentName.size() <= 80;
      allow delete: if isGate() || isAdmin() || (signedIn() && id.matches('.*_' + myKey()));
    }
    match /messages/{id} {
      allow read: if isAdmin() || canRead(resource.data.members);
      // A message by the person signed in, into a conversation they are in (members copied from the thread,
      // also for a thread created in the same save). At most 1,000 characters.
      allow create: if isMember(request.resource.data.members)
        && request.resource.data.from == myKey()
        && request.resource.data.threadId is string
        && request.resource.data.members == getAfter(/databases/$(database)/documents/threads/$(request.resource.data.threadId)).data.members
        && request.resource.data.text is string && request.resource.data.text.size() <= 1000
        // Up to 3 attachments (their details; the files are attachments/{id}). No text is fine when there is a file.
        && request.resource.data.get('files', []) is list && request.resource.data.get('files', []).size() <= 3
        && (request.resource.data.text.size() > 0 || request.resource.data.get('files', []).size() > 0)
        && (isStaff() || request.resource.data.keys().hasOnly(['id', 'threadId', 'members', 'from', 'fromName', 'text', 'at', 'files']));
      // Someone was added to the conversation: staff give the older messages the new members list.
      allow update: if isStaff() && isMember(request.resource.data.members)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members'])
        && request.resource.data.members.hasAll(resource.data.members);
      allow delete: if isAdmin();
    }

    // Gate scanners (ESP32 at the gate). Only the SHA-256 of each scanner key is saved. The admin adds and
    // cancels them; the Worker (gate account) checks a key and saves "last seen".
    match /scanners/{id} {
      allow read: if isAdmin() || isGate();
      allow create, delete: if isAdmin();
      allow update: if isAdmin()
        || (isGate() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastSeenAt']));
    }

    // Who changed what. Can never be edited or deleted.
    match /audit/{id} {
      allow read: if isAdmin();
      allow create: if isStaff();
      allow update, delete: if false;
    }
  }
}
