{
  "name": "doorbell-functions",
  "description": "Doorbell Cloud Functions: real SMS through Semaphore, and auto-confirm on a schedule",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "engines": { "node": "22" },
  "scripts": {
    "build": "esbuild index.js --bundle --platform=node --target=node22 --format=esm --packages=external --outfile=lib/index.js",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log"
  },
  "dependencies": {
    "firebase-admin": "^13.4.0",
    "firebase-functions": "^6.4.0"
  },
  "devDependencies": {
    "esbuild": "^0.25.0"
  }
}
